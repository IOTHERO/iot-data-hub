# HTTPS in front of the hub. CADDY_TLS in deploy/.env:
#   /certs/server.crt /certs/server.key  -> the certificate setup.sh made from deploy/ca (LAN, WSL):
#                         browsers, phones and devices all trust the one deploy/ca/ca.crt
#   an e-mail address  -> a free Let's Encrypt certificate (PUBLIC_HOST is a public domain, 80/443
#                         reachable from the internet)
{
	# clients that connect by IP address send no server name (SNI): give them this site's
	# certificate (DEFAULT_SNI = the first name given to setup.sh)
	default_sni {$DEFAULT_SNI}
}

{$PUBLIC_HOST} {
	tls {$CADDY_TLS}
	encode gzip
	# the hub sets its own security headers (CSP, nosniff, frame denial); HSTS here
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# the broker hooks are for EMQX inside the backend network only
	@hooks path /ingest/v1/broker/*
	respond @hooks 404
	reverse_proxy hub:8000
}
