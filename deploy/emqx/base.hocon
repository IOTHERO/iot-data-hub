# EMQX for native devices: devices only over TLS (8883, published on the host); every device signs
# in with its own credential and may use its own topics only - both decided by the hub
# (backend/api/ingest.py broker hooks).

# 1883 without TLS for the hub itself, on the internal Docker networks only (docker-compose.yml
# publishes 8883 alone, so this port is never reachable from the LAN or the internet)
listeners.tcp.default {
  enable = true
  bind = "0.0.0.0:1883"
}
listeners.ssl.default {
  bind = "0.0.0.0:8883"
  ssl_options {
    certfile = "/opt/emqx/etc/certs/server.crt"
    keyfile = "/opt/emqx/etc/certs/server.key"
    versions = ["tlsv1.3", "tlsv1.2"]
  }
}
listeners.ws.default.enable = false
listeners.wss.default.enable = false

# The hub's own account (HUB_PLATFORM_MQTT_USERNAME / PASSWORD in deploy/.env) is loaded into the
# built-in database on the first start (written by the emqx-init service); devices are checked by
# the hub over HTTP.
authentication = [
  {
    mechanism = password_based
    backend = built_in_database
    user_id_type = username
    bootstrap_file = "/opt/emqx/etc/bootstrap/users.csv"
    bootstrap_type = plain
  },
  {
    mechanism = password_based
    backend = http
    method = post
    url = "http://hub:8000/ingest/v1/broker/auth"
    headers {"content-type" = "application/json", "X-Hub-Hook-Token" = "${HUB_BROKER_HOOK_TOKEN}"}
    body {username = "${username}", password = "${password}", clientid = "${clientid}"}
  }
]

authorization {
  no_match = deny
  deny_action = disconnect
  sources = [
    {type = built_in_database, enable = true},
    {
      type = http
      method = post
      url = "http://hub:8000/ingest/v1/broker/acl"
      headers {"content-type" = "application/json", "X-Hub-Hook-Token" = "${HUB_BROKER_HOOK_TOKEN}"}
      body {username = "${username}", topic = "${topic}", action = "${action}"}
    }
  ]
}

mqtt.max_packet_size = 64KB
