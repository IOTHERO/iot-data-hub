# deploy/.env - made by ./setup.sh (random secrets); edit it afterwards. Never commit the real file.
# Placeholders only here. The full list of hub settings: the repository's .env.example.

# --- where the platform is reached --------------------------------------------------------------
# a public domain (Let's Encrypt), or the LAN address / name of this machine; several with commas:
# PUBLIC_HOST=192.168.1.20, titiswitch.local
PUBLIC_HOST=hub.example.com
# the name given to clients that connect by IP address (no SNI): the first of PUBLIC_HOST
DEFAULT_SNI=hub.example.com
# the certificate from deploy/ca (LAN / WSL), or an e-mail address = Let's Encrypt (public domain)
CADDY_TLS=/certs/server.crt /certs/server.key
HUB_PUBLIC_URL=https://hub.example.com

# a proxy only for building the image (pip and apt), e.g. http://127.0.0.1:10808 for v2rayN on
# Windows with WSL in mirrored mode; empty = direct internet access
BUILD_PROXY=
# when files.pythonhosted.org cannot be reached from this server (filtered DNS): a PyPI mirror
# you trust, e.g. your hosting provider's (its "simple" address); empty = pypi.org
BUILD_PIP_INDEX=
BUILD_PIP_TRUSTED_HOST=

# --- secrets (setup.sh fills these with random values) ------------------------------------------
DB_PASSWORD=
HUB_JWT_SECRET=
HUB_DATA_KEY=
EMQX_DASHBOARD_PASSWORD=
# at least 24 characters; the same value is given to EMQX (hooks) and the hub
HUB_BROKER_HOOK_TOKEN=
# the hub's own account on EMQX (created automatically on EMQX's first start)
HUB_PLATFORM_MQTT_USERNAME=hub
HUB_PLATFORM_MQTT_PASSWORD=

# --- the first administrator (made on the first start of an empty database) ---------------------
# One account, user name below, that works in the dashboard (/), the maker panel (/maker/) and the
# customer app (/app/); the first sign-in asks for a new password. setup.sh fills the password
# with a random one and prints it once. After the first sign-in this line does nothing; delete it.
HUB_BOOTSTRAP_ADMIN_USER=admin
HUB_BOOTSTRAP_ADMIN_PASSWORD=
# the manufacturer organization that account administers (the maker panel starts there)
HUB_BOOTSTRAP_MAKER_ORG=titiswitch
HUB_BOOTSTRAP_MAKER_NAME=TiTiSwitch

# --- behaviour ----------------------------------------------------------------------------------
HUB_TIMEZONE=Asia/Tehran
HUB_CONTROL_ENABLED=true
# customers create their own account in the app (e-mail + password); false = invitation only
HUB_SIGNUP_ENABLED=true
# auto: the e-mailed confirmation link is required only when an SMTP server is set below;
# without one a new account works at once. on / off force it.
HUB_EMAIL_VERIFICATION=auto
HUB_LOG_FORMAT=json
HUB_BACKUP_TIME=02:30
HUB_BACKUP_KEEP=14

# --- e-mail (sign-up, password reset, invitations); empty = no e-mail ---------------------------
HUB_SMTP_HOST=
HUB_SMTP_PORT=587
HUB_SMTP_SECURITY=starttls
HUB_SMTP_USERNAME=
HUB_SMTP_PASSWORD=
HUB_MAIL_FROM=no-reply@hub.example.com

# --- SMS panel (alarms to the home's people, and sign-in with a mobile number); none = off -
HUB_SMS_PROVIDER=none
HUB_SMS_API_KEY=
HUB_SMS_SENDER=
